{
  "name": "ll-ds",
  "historyRoot": "runs",
  "sddRoot": "sdd",
  "defaultAgent": "codex",
  "agents": {
    "codex": {
      "type": "codex",
      "command": "codex",
      "args": ["exec", "--ephemeral"]
    },
    "claude-code": {
      "type": "claude-code",
      "command": "claude",
      "args": ["-p"]
    }
  },
  "repositories": [
    {
      "id": "design-system",
      "label": "Design System",
      "path": "../../../design-system",
      "validation": [
        "npm run lint",
        "npm run build"
      ]
    },
    {
      "id": "design-system-foundation",
      "label": "Design System Foundation",
      "path": "../../../design-system-foundation",
      "validation": [
        "npm run lint",
        "npm run build"
      ]
    },
    {
      "id": "platform-front",
      "label": "Platform Frontend",
      "path": "../../../platform-front",
      "validation": [
        "npm run lint",
        "npm run build"
      ]
    }
  ]
}
