{
  "name": "example-workspace",
  "historyRoot": "runs",
  "sddRoot": "sdd",
  "githubProject": {
    "url": "https://github.com/orgs/example-org/projects/1"
  },
  "defaultAgent": "codex",
  "agents": {
    "codex": {
      "type": "codex",
      "command": "codex",
      "codex": {
        "sessionPolicy": "task",
        "resumeOnNeedsRework": true,
        "sandbox": "workspace-write",
        "approvalPolicy": "never",
        "models": {
          "mechanical": "gpt-5.6-luna",
          "standard": "gpt-5.6-terra",
          "deep": "gpt-5.6-sol"
        },
        "reasoning": {
          "mechanical": "low",
          "standard": "medium",
          "deep": "high"
        }
      }
    },
    "claude-code": {
      "type": "claude-code",
      "command": "claude",
      "args": ["-p"],
      "model": "configured-claude-model",
      "allowedModels": [
        "configured-claude-model",
        "lower-cost-claude-model"
      ]
    }
  },
  "tokenPolicy": {
    "contextBudgetTokens": 4000,
    "reviewDiffBudgetTokens": 2000,
    "batchRelatedTasks": false,
    "batchSize": 3
  },
  "repositories": [
    {
      "id": "backend",
      "label": "Example Backend",
      "path": "../../../example-backend",
      "docsHints": [
        "Keep repository-local human docs aligned with current backend behavior."
      ],
      "validation": [
        "npm test"
      ]
    },
    {
      "id": "frontend",
      "label": "Example Frontend",
      "path": "../../../example-frontend",
      "docsHints": [
        "Keep repository-local feature and route docs aligned with frontend behavior."
      ],
      "validation": [
        "npm run lint",
        "npm run build"
      ]
    }
  ]
}
